<Project>

  <!--
    Central package management for the MaintOrbit AI backend solution.

    docs/04-technology/package-policy.md:
      PM-1  Central package management is enabled
      PM-2  Project files declare PackageReference WITHOUT a Version attribute
      PM-3  Versions are declared once, here, and apply to every project
      PM-4  A version override in a project file requires a recorded reason

    Without this, EF Core can sit at one version in Infrastructure and another in a
    test project — producing failures that reproduce in CI and not locally, or the
    reverse.

    Adding a package requires passing the six admission gates in
    docs/04-technology/dependency-policy.md §3. The intended dependency set is
    inventoried in docs/04-technology/backend-technologies.md; entries are added here
    as the milestone that needs them lands, not in advance.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Testing — docs/04-technology/backend-technologies.md §11.

    NSubstitute is chosen over Moq, which introduced a contentious telemetry dependency.
    Shouldly is chosen over FluentAssertions, whose v8+ requires a commercial licence
    for commercial use (risk TR-11).
  -->
  <!--
    Abstractions only. Application and Infrastructure expose registration extensions, so
    they need IServiceCollection and IConfiguration — but nothing more. Referencing the
    ASP.NET shared framework instead would pull HTTP concerns into layers that must not
    know about transport (ADR-0001).

    The Api project needs no entry here: Microsoft.AspNetCore.App already carries these.
  -->
  <ItemGroup Label="Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
  </ItemGroup>

  <!--
    Persistence. Per docs/04-technology/backend-technologies.md §5.1, the runtime, EF Core, and
    Npgsql move together as one coordinated release train - the documented exception to
    "one major upgrade at a time".
  -->
  <!--
    Argon2id (SD-010). Accepted through docs/04-technology/dependency-policy.md:
    Gate 1 self-hostable - pure managed, no native binary; Gate 2 licence - MIT;
    Gate 4 - a key derivation function is never hand-written; Gate 5 replaceability -
    employee_credentials records algorithm and password_version per row, so a swap
    re-hashes each credential on next authentication.
    Gates 3 and 6 (maintenance health, named owner) require a human and an entry in the
    technology inventory, which this milestone does not modify.
  -->
  <ItemGroup Label="Cryptography">
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!--
    Access tokens. Microsoft.IdentityModel.JsonWebTokens is the library that
    Microsoft.AspNetCore.Authentication.JwtBearer - the package backend-technologies §7 lists
    for bearer token validation - is built on and already brings transitively. It is referenced
    directly so token issuance and validation carry no dependency on ASP.NET Core: the bearer
    middleware belongs to the API host, in the milestone that adds it.
  -->
  <ItemGroup Label="Authentication">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
