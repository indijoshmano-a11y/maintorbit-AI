<Project>

  <!--
    Shared build properties for every project in the MaintOrbit AI backend solution.

    Per docs/04-technology/package-policy.md PM-5, build properties live here rather
    than in individual project files. No project should redeclare any of these.

    Runtime target follows docs/04-technology/technology-stack.md §3 (TD-1): .NET 10 LTS.
    .NET 9 is a Standard Term Support release and is outside its support window.
  -->

  <PropertyGroup Label="Target">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Defect controls from docs/04-technology/coding-standards.md §4.1.

    C-1 and C-2 must never be relaxed. An unawaited async call in a handler silently
    discards work — potentially an audit write. Nullability errors prevent a defect
    class the domain model depends on.
  -->
  <PropertyGroup Label="Correctness">
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!--
    Reproducibility. docs/04-technology/package-policy.md PM-23: a clean checkout
    restores and builds with a single documented command.
  -->
  <PropertyGroup Label="Build">
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!--
    Suppressions. Each requires a recorded reason — docs/08-development/coding-standards.md
    §20 TD-5. A suppression without a justification is indistinguishable from an oversight.

    CA1716 — "identifier conflicts with a reserved language keyword"
      Flags MaintOrbit.Shared because 'Shared' is Visual Basic's equivalent of 'static'.
      The rule guards cross-language interop for library authors. This is an internal
      solution with no VB or F# consumers, and the project name is fixed by ADR-0001 and
      the Phase 0 structure — renaming it would change the architecture to satisfy a rule
      about a scenario that does not exist here.
  -->
  <PropertyGroup Label="Suppressions">
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Identity">
    <Company>MaintOrbit AI</Company>
    <Product>MaintOrbit AI</Product>
    <Authors>MaintOrbit AI</Authors>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!--
    Nothing under tests/ is published to a package feed. This is safe to key off the
    directory path because it is true of test projects and test support libraries alike.

    Properties that depend on a project actually BEING a test project are NOT set here.
    IsTestProject is owned by Microsoft.NET.Test.Sdk, which sets it when the package is
    referenced. Setting it by directory convention marks support libraries as test
    assemblies, and `dotnet test` then tries to run them without a test host.
    See Directory.Build.targets.
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('tests'))" Label="Tests">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
