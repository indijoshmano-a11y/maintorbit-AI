<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- A console executable, not a web host. DP-001 puts the Worker in its own container, and
         nothing here serves HTTP: readiness is reported by the process being alive and by the
         structured log, which is what a container orchestrator inspects for a background role. -->
    <OutputType>Exe</OutputType>
    <UserSecretsId>maintorbit-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaintOrbit.Application\MaintOrbit.Application.csproj" />
    <ProjectReference Include="..\MaintOrbit.Infrastructure\MaintOrbit.Infrastructure.csproj" />
    <ProjectReference Include="..\MaintOrbit.Shared\MaintOrbit.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MaintOrbit.Api.FunctionalTests" />
  </ItemGroup>

</Project>
