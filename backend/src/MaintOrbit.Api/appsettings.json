{
  "Application": {
    "Name": "MaintOrbit AI",
    "PublicBaseUrl": ""
  },
  "Api": {
    "BasePath": "/api/v1",
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "MaxQueryRangeDays": 90,
    "MaxFilterValuesPerParameter": 20
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": true,
    "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Authorization", "Content-Type", "Idempotency-Key", "X-Correlation-Id" ]
  },
  "HealthChecks": {
    "Enabled": true,
    "LivenessPath": "/health/live",
    "ReadinessPath": "/health/ready"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
