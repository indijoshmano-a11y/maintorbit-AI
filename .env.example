# =============================================================================
# MaintOrbit AI — environment template
# Copy to .env and fill in. NEVER commit the populated .env.
# =============================================================================

# ------------------------------------------------------------- runtime ----
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development
TZ=UTC

# ------------------------------------------------------------ postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maintorbit
POSTGRES_USER=maintorbit
POSTGRES_PASSWORD=
POSTGRES_MAX_POOL_SIZE=100
ConnectionStrings__Default=

# --------------------------------------------------------------- redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
ConnectionStrings__Redis=

# ----------------------------------------------------------- hangfire ----
ConnectionStrings__Hangfire=
HANGFIRE_DASHBOARD_ENABLED=true
HANGFIRE_WORKER_COUNT=

# ----------------------------------------------------------------- jwt ----
JWT_ISSUER=https://api.maintorbit.ai
JWT_AUDIENCE=maintorbit-web
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# --------------------------------------------------------------- oauth ----
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT_ID=
OAUTH_REDIRECT_URI=

# ---------------------------------------------------- secret encryption ----
# Key used to encrypt tenant-supplied AI provider credentials at rest.
DATA_PROTECTION_KEY=
CREDENTIAL_ENCRYPTION_KEY=
AZURE_KEY_VAULT_URI=

# ------------------------------------------ platform-level AI providers ----
# Optional fallback credentials owned by the platform, not by tenants.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# ------------------------------------------------------------- gateway ----
GATEWAY_DEFAULT_TIMEOUT_SECONDS=120
GATEWAY_MAX_RETRIES=2
GATEWAY_CIRCUIT_BREAKER_THRESHOLD=5

# ------------------------------------------------------------ frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# ----------------------------------------------------- vscode extension ----
MAINTORBIT_EXTENSION_API_URL=http://localhost:5000

# ----------------------------------------------------------- telemetry ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=maintorbit-api
LOG_LEVEL=Information
SEQ_URL=

# ---------------------------------------------------------------- mail ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@maintorbit.ai
SMTP_FROM_NAME=MaintOrbit AI

# --------------------------------------------------------------- nginx ----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=localhost
